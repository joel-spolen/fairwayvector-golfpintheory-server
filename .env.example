# Copy to .env and edit locally. Never commit real credentials.
HOST=127.0.0.1
PORT=8080
# Required: a randomly generated secret of at least 32 characters.
SERVER_API_TOKEN=
# Separate admin-only credential. Blank disables dashboard data access.
ADMIN_API_TOKEN=
DATA_DIR=./data
GOLF_API_KEY=
GPXZ_API_KEY=
# Explicit opt-in. Cached results are still served when disabled.
GOLF_API_ENABLED=false
GPXZ_API_ENABLED=false
# Maximum attempted provider HTTP calls per UTC day; failures count too.
GOLF_API_DAILY_LIMIT=100
GPXZ_DAILY_LIMIT=100
# Global maximum simultaneous upstream requests; excess misses return 503.
MAX_UPSTREAM_CONCURRENCY=4
# Persisted per-request failure lock and provider-wide error cooldown.
FAILURE_COOLDOWN_SECONDS=300
RATE_LIMIT_PER_MINUTE=120