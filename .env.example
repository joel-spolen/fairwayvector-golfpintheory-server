# Copy to a private local .env; never commit credentials.
# ONLY these loopback literals are accepted: 127.0.0.1 or ::1.
HOST=127.0.0.1
PORT=8080
# Optional: leave BOTH blank for a setup-only dashboard.
# Trusted HTTPS Supabase root, no path/query/fragment or local/IP host.
SUPABASE_URL=
# Server-only service_role JWT or sb_secret_ key. Never anon/publishable.
# Never enter this key in the browser. No outbound requests at startup.
SUPABASE_SERVICE_ROLE_KEY=