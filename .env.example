# Copy to .env and edit locally. Never commit real credentials.
HOST=127.0.0.1
PORT=8080
# Required: a randomly generated secret of at least 32 characters.
SERVER_API_TOKEN=
# Separate admin-only credential. Blank disables dashboard data access.
ADMIN_API_TOKEN=
# Optional aggregate-only Supabase account metrics; leave BOTH blank to disable.
# HTTPS project root only, no credentials/path/query/fragment or local/IP host.
# Custom DNS domains are allowed: use only a trusted Supabase deployment host.
SUPABASE_URL=
# Server-only legacy service_role JWT or sb_secret_ key; NEVER anon/publishable.
# Legacy JWT: apikey AND Authorization: Bearer. sb_secret_: apikey ONLY
# (Supabase secret gateway handles authentication; it is not a bearer JWT).
# No startup/overview requests; only authenticated GET /api/admin/accounts fetches.
# Success cached in memory 60s; failures 15s; stale data explicitly unavailable.
SUPABASE_SERVICE_ROLE_KEY=
DATA_DIR=./data
GOLF_API_KEY=
GPXZ_API_KEY=
# Explicit opt-in. Cached results are still served when disabled.
GOLF_API_ENABLED=false
GPXZ_API_ENABLED=false
# Maximum attempted provider HTTP calls per UTC day; failures count too.
GOLF_API_DAILY_LIMIT=100
GPXZ_DAILY_LIMIT=100
# Global maximum simultaneous upstream requests; excess misses return 503.
MAX_UPSTREAM_CONCURRENCY=4
# Persisted per-request failure lock and provider-wide error cooldown.
FAILURE_COOLDOWN_SECONDS=300
RATE_LIMIT_PER_MINUTE=120