<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Local admin GUI only. Keep HOST loopback; never expose via proxy/tunnel. -->
<dict>
  <key>Label</key>
  <string>com.fairwayvector.golfpintheory-server</string>
  <key>WorkingDirectory</key>
  <string>PROJECT_DIRECTORY</string>
  <key>ProgramArguments</key>
  <array>
    <string>NODE_EXECUTABLE</string>
    <string>--env-file-if-exists=.env</string>
    <string>src/index.js</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>PROJECT_DIRECTORY/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>PROJECT_DIRECTORY/logs/server-error.log</string>
</dict>
</plist>